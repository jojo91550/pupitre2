{
  "name": "pupitre2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @pupitre/app dev",
    "dev:mock": "pnpm --filter @pupitre/app dev:mock",
    "build": "pnpm --filter @pupitre/app build",
    "build:mock": "pnpm --filter @pupitre/app build:mock",
    "preview": "pnpm --filter @pupitre/app preview",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
