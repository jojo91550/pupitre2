{
  "name": "pupitre2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @pupitre/app --filter @pupitre/admin dev",
    "dev:mock": "pnpm --parallel --filter @pupitre/app --filter @pupitre/admin dev:mock",
    "build": "pnpm --filter @pupitre/app --filter @pupitre/admin build",
    "build:mock": "pnpm --filter @pupitre/app --filter @pupitre/admin build:mock",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck && tsc -p e2e",
    "test": "pnpm -r test",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0"
  }
}
